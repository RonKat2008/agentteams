{
  "name": "@agentteams/hub",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    }
  },
  "bin": {
    "agentteams-hub": "./dist/bin.js",
    "agentteams-hub-migrate": "./dist/bin-migrate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js dist/bin-migrate.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "kysely-pglite-dialect": "^1.3.1"
  },
  "dependencies": {
    "@agentteams/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  }
}
