# Shared look for every recording (run vhs from the repo root).
Set Shell zsh
Set FontFamily "Menlo"
Set FontSize 17
Set Width 1240
Set Height 620
Set Padding 26
Set Margin 22
Set MarginFill "#0A0C18"
Set BorderRadius 12
Set WindowBar Colorful
Set Theme "TokyoNight"
Set TypingSpeed 45ms
Set CursorBlink false
