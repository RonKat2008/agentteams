Source docs/demo/common.tape
Output assets/tui-join.gif
Set Width 1480
Set Height 900
Hide
Type "source docs/demo/prelude.zsh && unfunction agentteams && as jamie && cd $R/jamie/shop-api && clear" Enter
Sleep 1.5s
Show
Sleep 500ms
Type "agentteams" Sleep 300ms Enter
Sleep 1.8s
# Join a team with an invite code
Down Sleep 400ms Enter Sleep 1s
Type@4ms "__INVITE__" Sleep 800ms Enter
Sleep 1.2s
# Agent: Codex
Down Sleep 500ms Enter Sleep 1.2s
# Name prefilled: jamie. This directory already is a clone of the team's repo, so nothing is cloned.
Sleep 800ms Enter
Sleep 7s
Type "agentteams" Sleep 300ms Enter
Sleep 1.8s
# Team status is preselected once you are on a team
Sleep 600ms Enter
Sleep 5s
