Source docs/demo/common.tape
Output assets/tui-join.gif
Set Height 760
Hide
Type "export PORT=4747 && source docs/demo/prelude.zsh && unfunction agentteams && as jamie && cd $R/jamie/shop-api && clear" Enter
Sleep 1.5s
Show
Sleep 500ms
Type "agentteams" Sleep 300ms Enter
Sleep 1.8s
# Join a team with an invite code
Down Sleep 400ms Enter Sleep 1s
Type "__INVITE__" Sleep 500ms Enter
Sleep 1.2s
# Agent: Codex
Down Sleep 500ms Enter Sleep 1.2s
# Hub: local
Down Sleep 500ms Enter Sleep 1.4s
# Name prefilled: jamie
Enter Sleep 1.2s
# Use the current directory
Down Sleep 500ms Enter
Sleep 4s
Type "agentteams" Sleep 300ms Enter
Sleep 1.8s
# Team status is preselected once you are on a team
Sleep 600ms Enter
Sleep 5s
